# SiteSnap Environment Variables
# Add these to Vercel → Settings → Environment Variables

# Stripe Keys (get from dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_YOUR_SECRET_KEY_HERE
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_PUBLISHABLE_KEY_HERE

# App URL (update when you connect sitesnap.tech)
NEXT_PUBLIC_APP_URL=https://sitesnap-wheat.vercel.app

# Supabase (get from supabase.com → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://cozhabrvorseezbqimfn.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE
